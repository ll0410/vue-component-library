{
  "name": "vue-component-library",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r --filter=./packages/* build",
    "build:components": "pnpm --filter @my-lib/components build",
    "build:docs": "pnpm --filter @my-lib/docs build",
    "test": "pnpm -r --parallel test",
    "test:components": "pnpm --filter @my-lib/components test",
    "lint": "eslint . --ext .ts,.vue,.cjs --fix",
    "storybook": "pnpm --filter @my-lib/components storybook",
    "docs": "pnpm --filter @my-lib/docs dev",
    "playground": "pnpm --filter @vcl/playground dev",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "prettier": "^3.4.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "typescript": "^5.7.0",
    "vue-eslint-parser": "^9.0.0",
    "vue-tsc": "^2.2.0"
  }
}
